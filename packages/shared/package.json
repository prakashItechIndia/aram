{
  "name": "@aram/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Shared package for assets, OpenAPI clients, and common utilities across iCaptur apps",
  "keywords": [],
  "license": "ISC",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./_api": {
      "import": "./lib/_api/index.js",
      "types": "./lib/_api/index.d.ts"
    },
    "./providers": {
      "import": "./lib/providers/index.js",
      "types": "./lib/providers/index.d.ts"
    },
    "./hooks": {
      "import": "./lib/hooks/index.js",
      "types": "./lib/hooks/index.d.ts"
    }
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "generate-api": "cross-env OPENAPI_SWAGGER_KEY=SWAGGER_JSON_DEV_ENDPOINT_ARAM node openapi.generator.js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.18.1",
    "axios": "^1.2.1",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.1.3",
    "i18next": "^23.8.2",
    "libphonenumber-js": "^1.11.1",
    "moment": "^2.29.1",
    "neverthrow": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.5",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@openapitools/openapi-generator-cli": "2.5.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/validator": "^13.11.9",
    "cross-env": "^7.0.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.8.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.21"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}