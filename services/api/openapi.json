  "info": {
    "title": "Aram API",
    "description": "The Aram API description",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "aram",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "FeatureConfigItemDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "donation_form_enabled"
          },
          "value": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "key",
          "isEnabled"
        ]
      },
      "DonationFormConfigDto": {
        "type": "object",
        "properties": {
          "donationFormEnabled": {
            "type": "boolean",
            "description": "Form publicly accessible when true"
          },
          "maintenanceMessage": {
            "type": "string",
            "description": "Shown when form is disabled"
          },
          "testMode": {
            "type": "boolean",
            "description": "Test mode – no real transactions"
          },
          "multiCountrySupport": {
            "type": "boolean",
            "description": "Country dropdown vs default India"
          },
          "panRequirement": {
            "type": "string",
            "description": "always | threshold | optional_international"
          },
          "panThresholdAmount": {
            "type": "number"
          },
          "requireAddress": {
            "type": "boolean"
          },
          "requireMobile": {
            "type": "boolean"
          },
          "mobileOtpVerification": {
            "type": "boolean"
          },
          "presetAmounts": {
            "example": [
              500,
              1000,
              2500,
              5000
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minAmount": {
            "type": "number"
          },
          "maxAmount": {
            "type": "number"
          },
          "suggestRecurring": {
            "type": "boolean",
            "description": "Show recurring donation option"
          },
          "sendReceiptEmail": {
            "type": "boolean"
          },
          "sendReceiptSms": {
            "type": "boolean"
          },
          "send80GEmail": {
            "type": "boolean"
          }
        }
      },
      "GetFeatureConfigResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeatureConfigItemDto"
            }
          },
          "donationForm": {
            "$ref": "#/components/schemas/DonationFormConfigDto"
          }
        },
        "required": [
          "items",
          "donationForm"
        ]
      }
    }
  }
}