# Server
PORT=3000

# SQL Server (MSSQL) - use one of the formats below
# Option 1: Connection URL (encode special chars in password: # -> %23, ( -> %28, ) -> %29)
DATABASE_URL=mssql://Username:Password@Host:1433/DatabaseName
# Option 2: Or use connection string
# DATABASE_URL=Server=Host;Database=DbName;User Id=User;Password=Pass;Encrypt=true;TrustServerCertificate=false

# Option 3: Or use DB_* (password passed as separate property – recommended for # ; ( in password)
# DB_HOST=host
# DB_PORT=1433
# DB_DATABASE=dbname
# DB_USERNAME=user
# DB_PASSWORD="your-password"
# DB_ENCRYPT=false
# DB_TRUST_SERVER_CERTIFICATE=true

# JWT (used for donor and admin login)
JWT_SECRET=your-secret-key

# Admin portal (optional – for forgot-password reset link; dev shows link in response)
# ADMIN_APP_URL=https://admin.aram.org

# S3 – all file storage (gallery, sponsors logos, album covers) uses S3 only
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
# Optional: use IAM role / default credential chain instead
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# Optional: for MinIO or S3-compatible endpoint
# S3_ENDPOINT=http://localhost:9000
# Optional: custom base URL for returned asset URLs (e.g. CloudFront)
# S3_PUBLIC_URL_BASE=https://cdn.example.com
