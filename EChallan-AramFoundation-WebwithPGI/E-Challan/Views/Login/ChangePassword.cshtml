@model E_Challan.Models.ClsLogin

@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm()) {
    @Html.ValidationSummary(true)

   <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-xs-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">Change Password
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            @*<li class="refresher"><span class="icon "></span></li>
                            <li></li>
                            <li><span class=" icon-plus-sign bigger-110 purple my-tooltip-link" id='btnGridAdd' rel='tooltip' title='Add Education'></span></li>
                            <li><span class="icon-trash bigger-110 red my-tooltip-link" id='btnDelete1' rel='tooltip' title='Delete Education'></span></li>
                            <li><span class="icon-refresh bigger-110 green my-tooltip-link" id='btnGridRefresh' rel='tooltip' title='Refresh Data'></span></li>
                            <li><span class="icon-chevron-down bigger-110 green my-tooltip-link" id='btnToggleBox' rel='tooltip' title='Toggle Box'></span></li>*@
                        </ul>
                    </span>
                        </h4>
                    </div>
                    <div class="widget-body">
                        <div class="widget-main">
                            <div class="row">
                                <div class="form-horizontal">
                                    <div class="col-md-12">                                                                               
                                            <div class="col-md-5">
                                                <div class="form-group">
                                                    <div class="col-md-6" style="text-align: right">
                                                        <label>Current Password<span style="color: red;">*</span>:</label>
                                                    </div>
                                                    <div class="col-md-6">                                                        
                                                        @Html.PasswordFor(model => model.strPassword,new{maxlength=15,style="width: 100%;",@class = "form-control input-md"})
                                                        @Html.ValidationMessageFor(model => model.strPassword)
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-6" style="text-align: right">
                                                        <label>New Password<span style="color: red;">*</span>:</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.PasswordFor(model => model.strNewPassword,new{maxlength=15,style="width: 100%;",@class = "form-control input-md"})
                                                        @Html.ValidationMessageFor(model => model.strNewPassword)
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-6" style="text-align: right">
                                                        <label>Confirm Password<span style="color: red;">*</span>:</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @Html.PasswordFor(model => model.strConfirmPassword,new {maxlength=15,style="width: 100%;",@class = "form-control input-md"})
                                                        @Html.ValidationMessageFor(model => model.strConfirmPassword)
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <div class="col-md-6" style="text-align: right">
                                                    </div>
                                                    <div class="col-md-6">
                                                        <input type="submit" id="btnChange" class="btn btn-success" value="Change" />
                                                        <input type="button" id="btnClear" class="btn btn-success" value="Clear" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>                                   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
