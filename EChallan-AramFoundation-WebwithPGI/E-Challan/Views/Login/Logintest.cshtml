@model E_Challan.Models.ClsLogin

@{
    Layout = null;
}
<link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/Images/favicon.ico")" />


<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Aram Foundation Registraton Form</title>
    <link href='http://fonts.googleapis.com/css?family=Open+Sans:400,300,300italic,400italic,600'
        rel='stylesheet' type='text/css' />
    @Scripts.Render("~/bundles/jquery")
    <link href="@Url.Content("~/CSS/custom.css")" rel="stylesheet" />
    <link href="@Url.Content("~/AramCSS/bootstrap.min.css")" rel="stylesheet" />
</head>
<body>




    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)

        <!--header area-->
        <div class="header">
            <div class="container">
                <div class="row">
                    <div class="col-md-1">
                        <img class="nav-user-photo" src="@Url.Content("~/Images/logo-aram.png")" style="width:80px;"/>
                    </div>
                    <div class="col-md-10">
                        <h1 class="logo-name">
                            <span>ARAM Foundation - EChallan</span></h1>                        
                    </div>
                </div>
            </div>
        </div>
        <!--header area-->
        <div class="container ">
            <div class="form-holder">
                <div class="form-signin" role="form" runat="server">
                    <h2 class="form-signin-heading">Login</h2>
                    @Html.TextBoxFor(model => model.strUsername, new { @class = "form-control", maxlength = "50", Placeholder = "Username" })
                    @Html.ValidationMessageFor(model => model.strUsername)
                    <span id="errusername" style="color: red"></span>
                    @Html.PasswordFor(model => model.strPassword, new { @class = "form-control", maxlength = "50", Placeholder = "Password" })
                    @Html.ValidationMessageFor(model => model.strPassword)
                    <span id="errpwd" style="color: red"></span>
                    <input type="submit" class="btn btn-lg btn-primary btn-block" value="Sign in" />

                    <a href="@Url.Action("ForgotPassword", "Login")">Forget Password
                    </a>
                </div>
            </div>
        </div>
    }

</body>

<script>


    $(document).ready(function () {

        Clear();
        var login = '@TempData["Login"]';

        if (login == "WrongPassword") {
            $("#errpwd").html("Your password is wrong !!");

            //alert("Your password is wrong !!");
            return false;
        }

        else if (login == "WrongUsername") {

            $("#errusername").html("Your username is wrong !!");

            //alert("Your username is wrong !!");
            return false;
        }




    })

    function Clear() {
        $("input[type=text]").val("");
        $("input[type=number]").val("");
        $("input[type=password]").val("");
        $(".field-validation-error span").remove();
    }


</script>
@Scripts.Render("~/bundles/jqueryval")

</html>

