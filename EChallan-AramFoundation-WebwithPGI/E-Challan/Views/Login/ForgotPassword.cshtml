@model E_Challan.Models.ClsLogin

@{
    Layout = null;
}



<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Aram Foundation Registraton Form</title>
    <link href='http://fonts.googleapis.com/css?family=Open+Sans:400,300,300italic,400italic,600'
        rel='stylesheet' type='text/css' />
    @Scripts.Render("~/bundles/jquery")
    <link href="~/CSS/custom.css" rel="stylesheet" />
    <link href="~/AramCSS/bootstrap.min.css" rel="stylesheet" />
</head>
<body>




    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)

        <!--header area-->
        <div class="header">
            <div class="container">
                <div class="row">
                    <div class="col-md-1">
                        <img class="nav-user-photo" src="@Url.Content("~/Images/logo-aram.png")" style="width:80px;"/>
                    </div>
                    <div class="col-md-10">
                        <h1 class="logo-name">
                            <span>LEO MUTHU Scholarship</span></h1>
                        <h5 align="right">An Initiative of ARAM Foundation</h5>
                    </div>
                </div>
            </div>
        </div>
        <!--header area-->
        <div class="container ">
            <div class="form-holder">
                <div class="form-signin" role="form" runat="server">
                    <h2 class="form-signin-heading">Login</h2>
                    @Html.TextBoxFor(model => model.strEmail, new { @class = "form-control", maxlength = "50", Placeholder = "E-Mail" })
                    @Html.ValidationMessageFor(model => model.strEmail)
                    <span id="errusername" style="color: red"></span>

                    
                    <input type="button" class="btn btn-lg btn-primary btn-block" value="Recover" onclick="Onclick()"/>
                    <a href="@Url.Action("Logintest", "Login")">Back
                    </a>

                </div>
            </div>
        </div>
    }

</body>

<script>


    function Onclick() {
       
        var form1 = $("form:eq(0)");
        form1.validate();
        var result = form1.valid();
        if (!result) {
            return false;
        }
       
        var Email = $('#strEmail').val();

        $.ajax(
                  {

                      type: "POST",
                      url: '@Url.Content("~/")' + "Login/ForgotPswd",
                      data: "strEmail=" + Email,
                      dataType: "json",

                      success: function (data) {
                          var updatemsg = data;
                          if (updatemsg == "Error") {
                              alert("Please enter registered E-Mail ID !!");
                              $("#ModalInfo").html("Please enter registered E-Mail ID !!");
                              $('#LoginError').modal('show');
                              //alert("E-mail id is wrong.Please enter vaild mail id !!");
                          }
                          else if (updatemsg == "Success") {
                              alert("Your password has been send to your E-Maild ID !!");
                              $("#ModalInfo").html("<span style='color:#239616'>Your password has send your E-Maild ID !!</span>");
                              $('#LoginError').modal('show');
                              //alert("Your password has send your emaild id");
                          }
                      },
                      error: function (req, status, error) {
                          $("#UpdateError").modal('show');
                      }
                  });
              }

              function Clear() {
                  $("input[type=text]").val("");
                  $("input[type=number]").val("");
                  $("input[type=password]").val("");
                  $(".field-validation-error span").remove();
              }


</script>
@Scripts.Render("~/bundles/jqueryval")

</html>

