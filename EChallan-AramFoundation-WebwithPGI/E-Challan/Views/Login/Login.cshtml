@model E_Challan.Models.ClsLogin

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
</head>
<body>

    <div class="modal fade bs-example-modal-sm" id="LoginError">
        <div class="modal-dialog modal-sm clsModal">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Login</h4>
                </div>
                <div class="modal-body">
                    <p id="ModalInfo">&hellip;</p>
                </div>
                <div class="modal-footer">
                    @*<button type="button" class="btn btn-default" data-dismiss="modal">Ok</button>*@
                    <button type="button" class="btn btn-primary" data-dismiss="modal">Ok</button>
                </div>
            </div>
            <!-- /.modal-content -->
        </div>
        <!-- /.modal-dialog -->
    </div>

    <style>
        .field-validation-error {
            color: red;
        }

        #strPassword {
            top: 215px;
        }

        #strEmail {
            top: 215px;
        }

        .validate-msg .field-validation-error {
            display: block;
        }

        .validate-msg {
            box-sizing: border-box;
            font-size: 12px;
            margin-top: 130px;
            padding: 5px;
            position: relative;
            text-align: center;
            width: 100%;
        }

        .form-control::-moz-placeholder {
            color: #fff !important;
        }

        body {
            background-color: #171719 !important;
        }

        .clsModal p {
            color: #FF0000;
            font-weight: bold;
            margin: 0;
        }

        .clsModal {
            margin-top: 120px;
            width: 450px !important;
        }
        .btn {
            width:50px;
            height:30px;
        }
    </style>

    <link href="@Url.Content("~/Login_Page_Files/css/styles.css")" rel="stylesheet" />
    <link href="@Url.Content("~/FrameWork_Css/bootstrap.min.css")" rel="stylesheet" />
    <script src="@Url.Content("~/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/Login_Page_Files/js/script.js")"></script>
    <script src="@Url.Content("~/FrameWork_Js/bootstrap.min.js")" ></script>

    <div class="alert alert-block alert-warning" id="Divmess" style="display: none;">
        <button type="button" class="close" data-dismiss="alert">
            <i class="icon-remove"></i>
        </button>
        <i class="icon-ok green"></i>
        <span id="divmessup" style="color: #008000; font-weight: bold"></span>
    </div>

    <div id="formContainer">

        @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { @Id = "login" }))
        {
            <a href="#" id="flipToRecover" class="flipLink">Forgot?</a>
            @Html.TextBoxFor(m => m.strUsername, new { placeholder = "Username", maxlenth = "30", @class = "form-control input-md" })
         
            @Html.PasswordFor(m => m.strPassword, new { placeholder = "Password", maxlenth = "30", @class = "form-control input-md" })
        
            <div class="validate-msg">
                @Html.ValidationMessageFor(m => m.strUsername)
                @Html.ValidationMessageFor(m => m.strPassword)

            </div>
            <input type="submit" name="submitLogin" value="Login" id="btnLogin" />
        }

        @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post, new { @Id = "recover" }))
        {  
            <a href="#" id="flipToLogin" class="flipLink">Forgot?</a>
            @Html.TextBoxFor(m => m.strEmail, new { placeholder = "Email", maxlenth = "50", @class = "form-control input-md" })
           
            <div class="validate-msg">
                @Html.ValidationMessageFor(m => m.strEmail)

            </div>
            <input type="button" name="submitRecover" value="Recover" id="btnRecover" onclick="Onclick()" />
        }
    </div>



    <script type="text/javascript">

        function Onclick() {

            var form1 = $("form:eq(1)");
            form1.validate();
            var result = form1.valid();
            if (!result) {
                return false;
            }
            var Email = $('#strEmail').val();

            $.ajax(
                      {

                          type: "POST",
                          url: '@Url.Content("~/")' + "Login/ForgotPswd",
                          data: "strEmail=" + Email,
                          dataType: "json",

                          success: function (data) {
                              var updatemsg = data;
                              if (updatemsg == "Error") {
                                  $("#ModalInfo").html("Please enter registered E-Mail ID !!");
                                  $('#LoginError').modal('show');
                                  //alert("E-mail id is wrong.Please enter vaild mail id !!");
                              }
                              else if (updatemsg == "Success") {
                                  $("#ModalInfo").html("<span style='color:#239616'>Your password has send your E-Maild ID !!</span>");
                                  $('#LoginError').modal('show');
                                  //alert("Your password has send your emaild id");
                              }
                          },
                          error: function (req, status, error) {
                              $("#UpdateError").modal('show');
                          }
                      });
                  }

                  $(document).ready(function () {

                      Clear();
                      var login = '@TempData["Login"]';

                      if (login == "WrongPassword") {
                          $("#ModalInfo").html("Your password is wrong !!");
                          $('#LoginError').modal('show');
                          //alert("Your password is wrong !!");
                          return false;
                      }

                      else if (login == "WrongUsername") {

                          $("#ModalInfo").html("Your username is wrong !!");
                          $('#LoginError').modal('show');
                          //alert("Your username is wrong !!");
                          return false;
                      }


                      $("#flipToRecover").click(function () {

                          Clear();
                      });

                      $("#flipToLogin").click(function () {
                          Clear();
                      });

                  })

                  function Clear() {
                      $("input[type=text]").val("");
                      $("input[type=number]").val("");
                      $("input[type=password]").val("");
                      $(".field-validation-error span").remove();
                  }
    </script>

</body>

@Scripts.Render("~/bundles/jqueryval")

</html>
