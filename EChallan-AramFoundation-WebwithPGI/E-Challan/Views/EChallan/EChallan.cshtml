            if ((charCode > 47 && charCode < 58) || (charCode == 13) || (charCode == 9) || (charCode == 8) || (charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123) || (charCode == 9) || (charCode == 8) || (charCode == 13) || (charCode == 32)) {
