@model E_Challan.Models.ClsEChallan

@{
    ViewBag.Title = "PrintPdf";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    <title>Print PDF</title>
    }

@section PHbreadcrumb {
    <li>
        <i class="icon-home home-icon"></i>
        @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">E-Challan</li>
    <li class="active">E-Challan</li>
    <li class="active">Print PDF</li>

}

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">E-Challan
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>
                        </ul>
                    </span>
                        </h4>
                    </div>


                    <div class="widget-body">
                        <div class="widget-main">

                            <div class="row">
                                <div class="form-horizontal">
                                    <div class="alert alert-block alert-warning" id="Divmess" style="display: none;text-align:center;">
                                       @* <button type="button" class="close" data-dismiss="alert">
                                            <i class="icon-remove"></i>
                                        </button>*@
                                        <i class="icon-ok green"></i>
                                        <span id="divmessup" style="color: #008000; font-weight: bold;width:100%;text-align:center">Your Receipt has been successfully Saved.</span>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="col-md-6">
                                            <div class="form-group" style="text-align:center">
                                             <input type="button" id="btnPrint" class="btn btn-success buttonrecpt" value="Print Receipt" name="strButtonValue" />
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <div class="form-group" style="text-align:center">
                                                <input type="submit" id="btnAnother" class="btn btn-success buttonanother" value="Make Another Donation" name="strButtonValue" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    
    
    <style>

        .buttonrecpt {
            float:right;
            height: 50px;
            width:200px;
            margin-right: 10px;
            border-radius: 6px;
            font-size:15px;
            font-weight:bold;
        }

        .buttonanother {
            float:left;
            height: 50px;
            width:200px;
            margin-left: 10px;            
            border-radius: 6px;
            font-size:15px;
            font-weight:bold;
        }

        .widget-main {
            min-height: 370px;
        }

    </style>
    
    <script>
        $(document).ready(function () {
            $("#Divmess").show();

            $("#btnPrint").click(function () {
                $.ajax(
                                                {
                                                    type: "POST",
                                                    url: '@Url.Content("~/")' + "EChallan/JsonPrintPdf",
                                                    dataType: "json",

                                                    success: function (data) {
                                                        var updatemsg = data;

                                                        if (updatemsg == "Success") {
                                                            var newopen = '@Url.Content("~/")' + "EChallan/Report";
                                                            window.open(newopen);
                                                        }
                                                        else if (updatemsg == "Error") {

                                                        }

                                                    },
                                                    error: function (req, status, error) {

                                                    }
                                                })
            })


        });
    </script>
    
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
