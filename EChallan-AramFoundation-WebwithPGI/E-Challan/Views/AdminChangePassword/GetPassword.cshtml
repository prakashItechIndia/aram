@model E_Challan.Models.ClsAdminChgPwd

@{
    ViewBag.Title = "Create";
}


@using (Html.BeginForm()) {
    @Html.ValidationSummary(true)

<div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                   

                    <div class="widget-body">
                        <div class="widget-main">


                            <div class="row">
                                <div class="col-md-12">
                                                        <br />
                                                        <div class="form-group">
                                                            <div class="alert alert-block alert-success" id="divSuccessMsgStatus" style="display: none">
                                                                <button type="button" class="close" data-dismiss="alert">
                                                                    <i class="icon-remove"></i>
                                                                </button>
                                                                <i class="icon-ok green"></i>
                                                                <strong class="green">
                                                                    <span id="spanSuccessMsg" style="color: #008000; font-weight: bold; font-size: small;"></span>
                                                                </strong>
                                                            </div>
                                                        </div>
                                                    </div>
                                <div class="col-md-12">

                                    <div class="form-horizontal" role="form">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="col-md-5" align="right">
                                                    <label>Name<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-7">

                                                    @Html.DropDownListFor(model => model.strName, ViewBag.Users as IEnumerable<SelectListItem>,"--Select--", new { @class = "form-control input-md" })
                                                    @*@Html.DropDownListFor(model => model.strUserType,ViewData["Users"] as SelectList,"---- Select ----", new { @class = "form-control input-md"})*@

                                                 
                                                </div>
                                            </div>


                                           

                                            <div class="form-group">
                                                <div class="col-md-5" align="right">
                                                    <label>Password<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-7">
                                                    @Html.TextBoxFor(model => model.strPassword, new { @class = "form-control input-md",maxlength="50",disabled="disabled"})
                                                    @Html.ValidationMessageFor(model => model.strPassword)
                                                </div>
                                            </div>

                                            
                                         

                                          

                                        </div>
                                       
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>
                    
                   
                    <!-- /widget-main -->
                </div>
                <!-- /widget-body -->
            </div>
        </div>
        <!-- /.col -->
    </div>
    
    
    
}
    
@section Scripts {



    <script>

        function clearvalidatemess() {
            $(".field-validation-error span").remove();
        }

        $("#strName").change(function () {
         
            var a = $('#strName').val();
          
         

            $.ajax(
           {
               type: "GET",
               url: '@Url.Content("~/")' + "AdminChangePassword/GetPwd",
               dataType: "json",
               data: "userid=" + a,

               success: function (data) {
                   if (data != null) {
                       $('#strPassword').val(data);
                      
                   }

               },
               error: function (req, status, error) {
                   $("#UpdateError").modal('show');
               }
           });
        });


      
        

    </script>








@Scripts.Render("~/bundles/jqueryval")
}