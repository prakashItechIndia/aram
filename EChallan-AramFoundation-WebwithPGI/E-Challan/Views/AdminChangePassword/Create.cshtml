@model E_Challan.Models.ClsAdminChgPwd

@{
    ViewBag.Title = "Create";
}

@section Title {
    <title>Reset Password</title>
    }

@section PHbreadcrumb {
    <li> 
        <i class="icon-home home-icon"></i>
       @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">Administration</li>
    <li class="active">Reset Password</li>

}


@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">Reset Password
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>
                        </ul>
                    </span>
                        </h4>
                    </div>


                    <div class="widget-body">
                        <div class="widget-main">


                            <div class="row">
                                <div class="col-md-12">
                                    <br />
                                    <div class="form-group">
                                        <div class="alert alert-block alert-success" id="divSuccessMsgStatus" style="display: none">
                                            <button type="button" class="close" data-dismiss="alert">
                                                <i class="icon-remove"></i>
                                            </button>
                                            <i class="icon-ok green"></i>
                                            <strong class="green">
                                                <span id="spanSuccessMsg" style="color: #008000; font-weight: bold; font-size: small;"></span>
                                            </strong>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12">

                                    <div class="form-horizontal" role="form">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Name<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-7">

                                                    @Html.DropDownListFor(model => model.strName, ViewBag.Users as IEnumerable<SelectListItem>, "--Select--", new { @class = "form-control input-md",tabindex=1 })
                                                    @*@Html.DropDownListFor(model => model.strUserType,ViewData["Users"] as SelectList,"---- Select ----", new { @class = "form-control input-md"})*@

                                                    @Html.ValidationMessageFor(model => model.strName)
                                                </div>
                                            </div>


                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>User Type<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-7">

                                                    @Html.TextBoxFor(model => model.strUserType, new { @class = "form-control input-md", @disabled = "disabled" })
                                                </div>
                                            </div>



                                             <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                </div>

                                                <div class="col-md-7">

                                                    <input type="hidden" id="hideid" />

                                                    <input type="button" id="btnsubmit" value="Save" name="Create" class="btn btn-success" tabindex="4"/>

                                                    

                                                    <input type="button" id="btnclear" value="Clear " class="btn btn-success" tabindex="5"/>


                                                </div>
                                            </div>


                                        </div>

                                        <div class="col-md-6">

                                             <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Password<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-7">
                                                    @Html.PasswordFor(model => model.strPassword, new { @class = "form-control input-md", maxlength = "50",tabindex=2 })
                                                    @Html.ValidationMessageFor(model => model.strPassword)
                                                </div>
                                            </div>




                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Confirm Password<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-7">
                                                    @Html.PasswordFor(model => model.strConfirmPassword, new { @class = "form-control input-md", maxlength = "50",tabindex=3})
                                                    @Html.ValidationMessageFor(model => model.strConfirmPassword)
                                                </div>
                                            </div>


                                        </div>

                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>


                    <!-- /widget-main -->
                </div>
                <!-- /widget-body -->
            </div>
        </div>
        <!-- /.col -->
    </div>
    
    
    
}

@section Scripts {



    <script>

        function clearvalidatemess() {
            $(".field-validation-error span").remove();
        }

        $("#strName").change(function () {

            var a = $('#strName').val();
            if (a == "") {
                $('#strUserType').val("");
            }


            $.ajax(
           {
               type: "GET",
               url: '@Url.Content("~/")' + "AdminChangePassword/GetUserType",
               dataType: "json",
               data: "userid=" + a,

               success: function (data) {
                   
                   if (data != null) {
                       $('#strUserType').val(data);

                   }

               },
               error: function (req, status, error) {
                   $("#UpdateError").modal('show');
               }
           });
        });


       $(document).ready(function () {

           $('#btnsubmit').click(function () {

               var form1 = $("form:eq(1)");
               form1.validate();
               var result = form1.valid();
               if (!result) {
                   return false;
               }

               var form = $('form:eq(1)').serialize();
               var userid = $('#strName').val();
               $.ajax(
               {

                   type: "POST",
                   url: '@Url.Content("~/")' + "AdminChangePassword/Create",
                    dataType: "json",
                    data: form + "&userid=" + userid,

                    success: function (data) {

                        var updatemsg = data.strStatusMsg;
                        if (updatemsg == "Created") {
                            $("#Div2").fadeIn('slow');
                            $("#Div2").delay(4000).fadeOut('slow');
                            $('#UpdateSP').html("Saved Successfully...");


                        }
                        $('#strName').val("");
                        $("input[type=text]").val("");
                        $("input[type=number]").val("");
                        $("input[type=password]").val("");
                        clearvalidatemess();

                        $('#btnsubmit').show();
                    },
                    error: function (req, status, error) {
                        $("#UpdateError").modal('show');
                    }
                });
            });




            $("#btnclear").click(function () {
                $("input[type=text]").val("");
                $("input[type=password]").val("");
                $("#strName").val("");

                clearvalidatemess();

                return false;
            });





        });



    </script>








    @Scripts.Render("~/bundles/jqueryval")
}