@model E_Challan.Models.ClsEChallanReport

@{
    ViewBag.Title = "FundCollectionReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    <title>Fund Collection Report</title>
}

@section PHbreadcrumb {
<li>
    <i class="icon-home home-icon"></i>
    @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
</li>
<li class="active">Reports</li>
<li class="active">FundCollection Report</li>
}

<div class="alert alert-block alert-warning" id="Divmess" style="display: none;">
    <a href="~/Views/PrintReceipt/PrintReceipt.cshtml"></a>
    <button type="button" class="close" data-dismiss="alert">
        <i class="icon-remove"></i>
    </button>
    <i class="icon-ok green"></i>
    <span id="divmessup" style="color: red; font-weight: bold"></span>
</div>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)


    <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">FundCollection Report
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>
                             <li>          
                                <img id="imgPDF" alt="" src="@Url.Content("~/Images/pdf.png")" title="Export To PDF" style="cursor: pointer;height: 23px; margin-right: 10px;width: 25px;" />
                            </li>

                            <li>
                                <img id="imgExcel" alt="" src="@Url.Content("~/Images/excel.ico")" title="Export To Excel" style="width: 20px; height: 20px;cursor: pointer;" />
                           </li>
                           
                        </ul>
                    </span>
                        </h4>
                    </div>

                    <div class="widget-body">
                        <div class="widget-main">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <div class="col-md-5" align="">
                                                <label>Donor Type :</label>
                                            </div>
                                            <div class="col-md-8">
                                                @Html.DropDownListFor(model => model.DonorTypes, ViewBag.donor as IEnumerable<SelectListItem>, new { @class = "form-control input-md", @style = "width:100%" })
                                                @Html.ValidationMessageFor(model => model.DonorTypes)
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <div class="col-md-5" align="">
                                                <label>Period :</label>
                                            </div>
                                            <div class="col-md-8">
                                                @(Html.Kendo().DropDownListFor(model => model.period)
                                                .HtmlAttributes(new { style = "width:164px" })
        // .OptionLabel("--Select--")
                                                  .DataTextField("Text")
                                                  .DataValueField("Value")
                                                    .Events(e => e.Change("change"))
                                                  .BindTo(new List<SelectListItem>() {
                                                      new SelectListItem() {
                                                          Text = "Today",
                                                          Value = "Today"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "Yesterday",
                                                          Value = "Yesterday"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "Current Week",
                                                          Value = "Current Week"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "Last Week",
                                                          Value = "Last Week"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "Current Month",
                                                          Value = "Current Month"
                                                      },
                                                       new SelectListItem() {
                                                          Text = "Last Month",
                                                          Value = "Last Month"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "Current Year",
                                                          Value = "Current Year"
                                                      },
                                                      
                                                      new SelectListItem() {
                                                          Text = "Last Year",
                                                          Value = "Last Year"
                                                      
                                                      },
                                                       new SelectListItem() {
                                                          Text = "Custom Date",
                                                          Value = "Custom Date"
                                                       }
                                                      
                                                  }))
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <div class="col-md-5" align="">
                                                <label>From Date :</label>
                                            </div>
                                            <div class="col-md-8">
                                                @Html.TextBoxFor(Model => Model.FromDate, new { onkeypress = "return restricttype(event)", @readonly = "readonly" })                                    
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <div class="col-md-5" align="">
                                                <label>To Date :</label>
                                            </div>
                                            <div class="col-md-11">
                                                @Html.TextBoxFor(Model => Model.ToDate, new { onkeypress = "return restricttype(event)", @readonly = "readonly" })                     
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
}
@section Scripts {

    <script>

        function clearvalidatemess() {
            $(".field-validation-error span").remove();
        }

        $(document).ready(function () {

            $("#FromDate").kendoDatePicker({
                format: "dd/MM/yyyy",

            });
            $("#ToDate").kendoDatePicker({
                format: "dd/MM/yyyy",

            });

            $('#imgPDF').click(function () {
                var DonorId = $('#DonorTypes').val();
                var FromDate = $('#FromDate').val();
                var ToDate = $('#ToDate').val();

                $.ajax(
                                               {
                                                   type: "POST",
                                                   url: '@Url.Content("~/")' + "Report/Checkreport",
                                                   data: "DonorId=" + DonorId + "&FromDate=" + FromDate + "&ToDate=" + ToDate,
                                                    dataType: "json",

                                                    success: function (data) {
                                                        var updatemsg = data;

                                                        if (updatemsg == "Success") {
                                                            var newopen = '@Url.Content("~/")' + "Report/ReportToPDF?DonorId=" + DonorId + "&FromDate=" + FromDate + "&ToDate=" + ToDate;
                                                                    window.open(newopen);
                                                                    $('#maskBox').height($(window).height()).fadeOut(500);
                                                                }
                                                                else if (updatemsg == "Error") {
                                                                    $("#Divmess").fadeIn('slow');
                                                                    $("#Divmess").delay(4000).fadeOut('slow');
                                                                    $('#divmessup').html("No Receipt found..!");
                                                                    $('#masterCheckBox').prop('checked', false);
                                                                    // alert($('#divmessup').val());

                                              }

                        clearvalidatemess();

                    },
                    error: function (req, status, error) {
                        $("#UpdateError").modal('show');
                    }
                });
            });

            $('#imgExcel').click(function () {
                var DonorId = $('#DonorTypes').val();
                var FromDate = $('#FromDate').val();
                var ToDate = $('#ToDate').val();

                $.ajax(
                                               {
                                                   type: "POST",
                                                   url: '@Url.Content("~/")' + "Report/Checkreport",
                                                   data: "DonorId=" + DonorId + "&FromDate=" + FromDate + "&ToDate=" + ToDate,
                                                   dataType: "json",

                                                   success: function (data) {
                                                       var updatemsg = data;

                                                       if (updatemsg == "Success") {
                                                           var newopen = '@Url.Content("~/")' + "Report/ReportToExcel?DonorId=" + DonorId + "&FromDate=" + FromDate + "&ToDate=" + ToDate;
                                                            window.open(newopen);
                                                            $('#maskBox').height($(window).height()).fadeOut(500);
                                                        }
                                                        else if (updatemsg == "Error") {
                                                            $("#Divmess").fadeIn('slow');
                                                            $("#Divmess").delay(4000).fadeOut('slow');
                                                            $('#divmessup').html("No Receipt found..!");
                                                            $('#masterCheckBox').prop('checked', false);
                                                            // alert($('#divmessup').val());

                                                        }

                                                        clearvalidatemess();

                                                    },
                                                   error: function (req, status, error) {
                                                       $("#UpdateError").modal('show');
                                                   }
                                               });
             });


            $('#btnclear').click(function () {

                $("#DonorTypes").val("");
                $("#FromDate").val("");
                $("#ToDate").val("");

            })

        })

        //function getdates() {
        //    var today = new Date();
        //    var currentYear = today.getFullYear();
        //    var currentMonth = today.getMonth();
        //    var currentDay = today.getDate();
        //    var mm = today.getMonth() + 1;
        //    var qq = today.getDate() + "/" + mm + "/" + today.getFullYear();

        //    //$("#FromDate").val(qq);
        //    //$("#ToDate").val(qq);


        //}

    </script>
    <script>
        $(document).ready(function () {
            getdates();
        });


        function getdates() {
            var today = new Date();
            var currentYear = today.getFullYear();
            var currentMonth = today.getMonth();
            var currentDay = today.getDate();
            var mm = today.getMonth() + 1;
            var qq = today.getDate() + "/" + mm + "/" + today.getFullYear();

            $("#FromDate").val(qq);
            $("#ToDate").val(qq);
            var fromdatepicker = $("#FromDate").data("kendoDatePicker");
            fromdatepicker.enable(false);
            var todatepicker = $("#ToDate").data("kendoDatePicker");
            todatepicker.enable(false);

        }
        function change() {
            var today = new Date();
            var currentYear = today.getFullYear();
            var currentMonth = today.getMonth();
            var currentDay = today.getDate();
            var period = $('#period').val();


            if (period == 'Current Month') {
                debugger;
                //months in JS counting from 0, so 0 - january, 8 - september 
                var firstDayCurrMonth = new Date(currentYear, currentMonth, 1);
                var lastDayCurrMonth = new Date(currentYear, currentMonth + 1, 0);

                var mm = firstDayCurrMonth.getMonth() + 1;
                var fdc = firstDayCurrMonth.getDate() + "/" + mm + "/" + firstDayCurrMonth.getFullYear();
                $("#FromDate").val(fdc);
                var mm = lastDayCurrMonth.getMonth() + 1;
                var ldc = lastDayCurrMonth.getDate() + "/" + mm + "/" + lastDayCurrMonth.getFullYear();
                $("#ToDate").val(ldc);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);


                // zero day of current month is last day of prev month
            }


            else if (period == "Last Month") {
                var firstDayPrevMonth = new Date(currentYear, currentMonth - 1, 1);
                var lastDayPrevMonth = new Date(currentYear, currentMonth, 0);
                var mm = firstDayPrevMonth.getMonth() + 1;
                var fdp = firstDayPrevMonth.getDate() + "/" + mm + "/" + firstDayPrevMonth.getFullYear();
                $("#FromDate").val(fdp);
                var mm = lastDayPrevMonth.getMonth() + 1;
                var ldp = lastDayPrevMonth.getDate() + "/" + mm + "/" + lastDayPrevMonth.getFullYear();
                $("#ToDate").val(ldp);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);
            }

            else if (period == "Current Year") {
               
               // var firstDayCurrYear = new Date(currentYear, 0, 1);
               // var lastDayCurrYear = new Date(currentYear + 1, 0, 0);
               // var mm = firstDayCurrYear.getMonth() + 1;
                var fdcy = "01/04/" + currentYear;
                $("#FromDate").val(fdcy);
                var year = currentYear + 1;
               // var mm = lastDayCurrYear.getMonth() + 1;
                var ldcy = "31/03/" + year;
                $("#ToDate").val(ldcy);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);
            }

                // zero day of zero month is last day of prev year
            else if (period == "Last Year") {
                //var firstDayPrevYear = new Date(currentYear - 1, 0, 1);
                //var lastDayPrevYear = new Date(currentYear, 0, 0);
                //  var mm = firstDayPrevYear.getMonth() + 1;
                var years = currentYear - 1;
                var fdcy = "01/04/" + years;
                $("#FromDate").val(fdcy);
               // var mm = lastDayPrevYear.getMonth() + 1;
                var ldcy = "31/03/" + currentYear;
                $("#ToDate").val(ldcy);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);

            }


            else if (period == "Current Week") {
                if (today.getDay() == 0)
                    var dayNumWeek = today.getDay() + 6;
                else
                    var dayNumWeek = today.getDay() - 1;

                var firstDayCurrWeek = new Date(today.getTime() - dayNumWeek * 1000 * 60 * 60 * 24);
                var lastDayCurrWeek = new Date(today.getTime() + (6 - dayNumWeek) * 1000 * 60 * 60 * 24);
                var mm = firstDayCurrWeek.getMonth() + 1;
                var fdcw = firstDayCurrWeek.getDate() + "/" + mm + "/" + firstDayCurrWeek.getFullYear();
                $("#FromDate").val(fdcw);
                var mm = lastDayCurrWeek.getMonth() + 1;
                var ldcw = lastDayCurrWeek.getDate() + "/" + mm + "/" + lastDayCurrWeek.getFullYear();
                $("#ToDate").val(ldcw);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);

            }


            else if (period == "Last Week") {
                if (today.getDay() == 0)
                    var dayNumWeek = today.getDay() + 6;
                else
                    var dayNumWeek = today.getDay() - 1;
                var firstDayPrevWeek = new Date(today.getTime() - 7 * 1000 * 60 * 60 * 24 - dayNumWeek * 1000 * 60 * 60 * 24);
                var lastDayPrevWeek = new Date(today.getTime() - 7 * 1000 * 60 * 60 * 24 + (6 - dayNumWeek) * 1000 * 60 * 60 * 24);
                var mm = firstDayPrevWeek.getMonth() + 1;
                var fdpw = firstDayPrevWeek.getDate() + "/" + mm + "/" + firstDayPrevWeek.getFullYear();
                $("#FromDate").val(fdpw);
                var mm = lastDayPrevWeek.getMonth() + 1;
                var ldpw = lastDayPrevWeek.getDate() + "/" + mm + "/" + lastDayPrevWeek.getFullYear();
                $("#ToDate").val(ldpw);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);

            }


            else if (period == "Today") {


                //function formatDate(value) {
                //var qq = today.getMonth() + 1 + "/" + today.getDate() + "/" + today.getFullYear();
                var mm = today.getMonth() + 1;
                var qq = today.getDate() + "/" + mm + "/" + today.getFullYear();

                $("#FromDate").val(qq);
                $("#ToDate").val(qq);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);


            }


            else if (period == "Yesterday") {
                var d = new Date();

                d.setDate(d.getDate() - 1); // <-- add this to make it "yesterday"

                var curr_date = d.getDate(); // <-- don't subtract 1 anymore
                var curr_month = d.getMonth() + 1;
                var curr_year = d.getFullYear();
                var yesterday = curr_date + "/" + curr_month + "/" + curr_year;
                $("#FromDate").val(yesterday);
                $("#ToDate").val(yesterday);
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");
                fromdatepicker.enable(false);
                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(false);
            }


            else if (period == "Custom Date") {
                debugger;
                $("#FromDate").val("");
                $("#ToDate").val("");
                var fromdatepicker = $("#FromDate").data("kendoDatePicker");

                fromdatepicker.enable(true);


                var todatepicker = $("#ToDate").data("kendoDatePicker");
                todatepicker.enable(true);

            }



        }
    </script>

    @Scripts.Render("~/bundles/jqueryval")
}

