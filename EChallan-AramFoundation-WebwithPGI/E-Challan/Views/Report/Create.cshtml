@model E_Challan.Models.ClsEChallanReport

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    <title>EChallan Report</title>
}

@section PHbreadcrumb {
    <li>
        <i class="icon-home home-icon"></i>
        @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">Reports</li>
    <li class="active">EChallan Report</li>

}



@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)


    <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">EChallan Report
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>

                            <li>
                                <input type="button" id="btnsearch" value="Search" class="btn btn-info" /></li>
                            <li>
                                <input type="button" id="btnclear" value="Clear" class="btn btn-info" /></li>

                            <li><a href="@Url.Action("ExportToExcel", "Report")">
                                <img alt="" src="@Url.Content("~/Images/excel.ico")" title="Export To Excel" style="width: 20px; height: 20px;" />
                            </a></li>
                            @* <li><a href="@Url.Action("ExportToPdf","MemberPackageReport")">
                                <img alt="" src="/Images/pdf.gif" title="Export To PDF" />
                            </a></li>*@
                            @*<li><span class=" icon-plus-sign bigger-110 purple my-tooltip-link" id='btnGridAdd' rel='tooltip' title='Search'></span></li>

                            <li><span class="icon-refresh bigger-110 green my-tooltip-link" id='btnGridRefresh' rel='tooltip' title='Refresh Data'></span></li>
                            <li><span class="icon-chevron-down bigger-110 green my-tooltip-link" id='btnToggleBox' rel='tooltip' title='Toggle Box'></span></li>*@
                        </ul>
                    </span>
                        </h4>
                    </div>

                    <div class="widget-body">
                        <div class="widget-main">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <div class="col-md-6" align="right">

                                                <label>Donor Type<span style="color: red;">*</span> :</label>
                                            </div>
                                            <div class="col-md-6">
                                                @Html.DropDownListFor(model => model.DonorTypes, ViewBag.donor as IEnumerable<SelectListItem>, new { @class = "form-control input-md", @style = "width:100%" })
                                                @Html.ValidationMessageFor(model => model.DonorTypes)
                                            </div>
                                        </div>



                                    </div>

                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <div class="col-md-6" align="right">

                                                <label>Payment Mode<span style="color: red;">*</span> :</label>
                                            </div>
                                            <div class="col-md-6">

                                                @Html.DropDownListFor(model => model.PaymentMode, new List<SelectListItem>
                                                     {
                                                        new SelectListItem{ Text="All", Value = "All" }, 
                                                        new SelectListItem{ Text="Cash", Value = "Cash"},
                                                        new SelectListItem{ Text="Cheque", Value = "Cheque" },
                                                        new SelectListItem{ Text="DD", Value = "DD" }
                                                     }, new { style = "width: 100%;" })
                                                @Html.ValidationMessageFor(model => model.PaymentMode)
                                            </div>
                                        </div>



                                    </div>

                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <div class="col-md-5" align="right">

                                                <label>From Date<span style="color: red;">*</span> :</label>
                                            </div>

                                            <div class="col-md-7">
                                                @Html.TextBoxFor(Model => Model.FromDate, new { onkeypress = "return restricttype(event)", @readonly = "readonly" })
                                                @Html.ValidationMessageFor(model => model.FromDate)
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <div class="col-md-5" align="right">

                                                <label>To Date<span style="color: red;">*</span> :</label>
                                            </div>

                                            <div class="col-md-7">
                                                @Html.TextBoxFor(Model => Model.ToDate, new { onkeypress = "return restricttype(event)", @readonly = "readonly" })

                                                @Html.ValidationMessageFor(model => model.ToDate)
                                            </div>
                                        </div>
                                    </div>




                                </div>
                            </div>
                        </div>

                        <div class="form-group">

                            @(Html.Kendo().Grid<E_Challan.Models.ClsEChallanReport>()
                                .Name("Reportgrid")
                                .Columns(c =>
                                {
                                    c.Bound(p => p.Receipt_No).Title("Receipt No");
                                    c.Bound(p => p.Receipt_Date).Title("Receipt Date");
                                    c.Bound(p => p.DonorTypes).Title("Donor Type");
                                    //c.Bound(p => p.Account_No).Title("Acc No");
                                    c.Bound(p => p.Name_Of_Donor).Title("Name");
                                    // c.Bound(p => p.Street).Title("Street");
                                    //  c.Bound(p => p.City).Title("City");
                                    //  c.Bound(p => p.Pincode).Title("Pincode");
                                    // c.Bound(p => p.Telephone).Title("Telephone");
                                    c.Bound(p => p.Mobile).Title("Mobile");
                                    //  c.Bound(p => p.Email).Title("Email");
                                    c.Bound(p => p.PaymentMode).Title("Payment Mode");
                                    c.Bound(p => p.Amount).Title("Amount");
                                    c.Bound(p => p.strDDorChequeNumber).Title("DD/Cheque No");
                                    c.Bound(p => p.DDChequeDate).Title("DD/Cheque Date");
                                    c.Bound(p => p.CreatedDate).Title("Created Date");
                                    //  c.Bound(p => p.PANcardNumber).Title("PAN");


                                })
                               .HtmlAttributes(new { style = "height:400px" })
                                .Sortable()
                                .Scrollable()
                                .Pageable()
                                .DataSource(dataSource => dataSource
                                 .Ajax()
                                 .Read(read => read.Action("Grid_Read", "Report").Data("ReadGrid"))
                                 .PageSize(1000)
                                 .Aggregates(aggregates =>
            {

                aggregates.Add(p => p.Amount).Sum();
            })
         )

                              )


                            <script type="text/javascript">
                                function ReadGrid() {

                                    return { DonorTypes: $('#DonorTypes').val(), PaymentMode: $('#PaymentMode').val(), FromDate: $('#FromDate').val(), ToDate: $('#ToDate').val() }
                                }
                            </script>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    
}
@section Scripts {

    <script>

        function clearvalidatemess() {
            $(".field-validation-error span").remove();
        }

        $(document).ready(function () {

            $("#FromDate").kendoDatePicker({
                format: "dd/MM/yyyy",

            });
            $("#ToDate").kendoDatePicker({
                format: "dd/MM/yyyy",

            });

            getdates();

            $('#btnsearch').click(function () {

                var form1 = $("form:eq(1)");
                form1.validate();
                var result = form1.valid();
                if (!result) {
                    return false;
                }
                $('#Reportgrid').data('kendoGrid').dataSource.read();
               @* var form = $('form:eq(1)').serialize();
                $.ajax(
                {

                    type: "POST",
                    url: '@Url.Content("~/")' + "Report/Search",
                    dataType: "json",
                    data: form,

                    success: function (data) {
                        var d = $("#Reportgrid").data("kendoGrid");
                        //d.dataSource.pageSize(10);
                        d.dataSource.data(data.ClsCommon.lstEchallanReport);
                        //d.dataSource.read();

                        var updatemsg = data.strStatusMsg;
                        if (updatemsg == "No") {
                            $("#Div2").fadeIn('slow');
                            $("#Div2").delay(4000).fadeOut('slow');
                            $('#UpdateSP').html("No Records Found...");

                        }

                        clearvalidatemess();

                    },
                    error: function (req, status, error) {
                        $("#UpdateError").modal('show');
                    }
                });*@
            });

            $('#btnclear').click(function () {

                $("#DonorTypes").val("");
                $("#PaymentMode").val("");
                $("#FromDate").val("");
                $("#ToDate").val("");

            })

        })


        function getdates() {
            var today = new Date();
            var currentYear = today.getFullYear();
            var currentMonth = today.getMonth();
            var currentDay = today.getDate();
            var mm = today.getMonth() + 1;
            var qq = today.getDate() + "/" + mm + "/" + today.getFullYear();

            $("#FromDate").val(qq);
            $("#ToDate").val(qq);


        }


    </script>

    <style>
        .btn.btn-info {
            margin-right: 10px;
        }
    </style>


    @Scripts.Render("~/bundles/jqueryval")
}