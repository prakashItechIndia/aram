@model E_Challan.Models.ClsDonorCategories

@{
    ViewBag.Title = "DonorCategories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    <title>Donation Categories</title>
    }

@section PHbreadcrumb {
    <li>
        <i class="icon-home home-icon"></i>
        @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">Administration</li>
    <li class="active">Donation Categories</li>

}
<div class="alert alert-block alert-warning" id="Divmess" style="display: none;">
    <button type="button" class="close" data-dismiss="alert">
        <i class="icon-remove"></i>
    </button>
    <i class="icon-ok green"></i>
    <span id="divmessup" style="color: #008000; font-weight: bold"></span>
</div>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    
    <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">Donation Categories
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>
                            <li></li>
                            <li><span class=" icon-plus-sign bigger-110 purple my-tooltip-link" id='btnGridAdd' rel='tooltip' title='Add State'></span></li>
                            <li><span class="icon-trash bigger-110 red my-tooltip-link" id='btnDelete1' rel='tooltip' title='Delete State'></span></li>
                            <li><span class="icon-refresh bigger-110 green my-tooltip-link" id='btnGridRefresh' rel='tooltip' title='Refresh Data'></span></li>
                            <li><span class="icon-chevron-down bigger-110 green my-tooltip-link" id='btnToggleBox' rel='tooltip' title='Toggle Box'></span></li>
                        </ul>
                    </span>
                        </h4>
                    </div>

                    <div class="widget-body">
                        <div class="widget-main editBox">
                            <div class="row">
                                <div class="col-md-12">

                                    <div class="form-horizontal" role="form">
                                        <div class="col-md-6">

                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Type Of Donation<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-6">
                                                    @Html.TextBoxFor(model => model.DonorTypes, new { onkeypress = "return OnlyAlphabets(event)", @class = "form-control input-md", maxlength = "50" })
                                                    @Html.ValidationMessageFor(model => model.DonorTypes)
                                                </div>
                                            </div>


                                             <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Donation Code<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-6">
                                                    @Html.TextBoxFor(model => model.DonationCode, new { onkeypress = "return OnlyAlphabets(event)", @class = "form-control input-md", maxlength = "3" })
                                                    @Html.ValidationMessageFor(model => model.DonationCode)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Account Number<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-6">
                                                    @Html.TextBoxFor(model => model.AccountNo, new { onkeypress = "return OnlyNumbersSpecial(event)", @class = "form-control input-md", maxlength = "25" })
                                                    @Html.ValidationMessageFor(model => model.AccountNo)
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                    <label>Is Active<span style="color: red;">*</span> :</label>
                                                </div>
                                                <div class="col-md-6">
                                                     @* @Html.CheckBoxFor(model => model.IsActive)*@
                                                    <input id="IsActive" name="chkStatusassigning" class="ace ace-switch ace-switch-5" type="checkbox" />  
                                                    <span class="lbl"></span>                                               
                                                    <span style="color: red" id="Errcheck"></span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <div class="col-md-4" align="right">
                                                </div>

                                                <div class="col-md-6">

                                                    <input type="hidden" id="hideid" />

                                                    <input type="button" id="btnsubmit" value="Save" name="Create" class="btn btn-success" />

                                                    <input type="button" id="btnmodify" value="Update " style="display: none" class="btn btn-success" />

                                                    <input type="button" id="btnclear" value="Clear " class="btn btn-success" />

                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="form-group">
                        @(Html.Kendo().Grid<E_Challan.Models.ClsDonorCategories>()
                            .Name("DonorGrid")
                            .Columns(columns =>
                            {
                                columns.Bound(p => p.Id).HeaderTemplate("ID").Visible(false);
                                columns.Bound(p => p.Id).ClientTemplate("<input type='checkbox' #= IsCheck ? checked='checked':'' # class='chkbx' name='check' value='#= Id #'/>").Width(15)
                               .HeaderTemplate("<input type='checkbox' id='masterCheckBox' onclick='checkAll(this)'/>").Filterable(false);
                                columns.Bound(p => p.Id).ClientTemplate("<div id='#= Id #' class='icon-pencil bigger-130 blue cursorPointer'  onclick='ProCatEdit(this.id)' rel='tooltip' title='Edit selected row'/>").Width(15).Title("Edit").Filterable(false);
                                columns.Bound(p => p.DonorTypes).Width(100).Title("Type Of Donation");
                                columns.Bound(p => p.DonationCode).Width(100).Title("Donation Code");
                                columns.Bound(p => p.AccountNo).Width(100).Title("Account Number");
                                columns.Bound(p => p.strStatus).Width(100).Title("Is Active");
                                
                                //columns.Bound(p => p.IsActive).Title("Active");
                            })
                            .Selectable(selectable => selectable
                                        .Mode(GridSelectionMode.Multiple))
                                       .Pageable(pager => { pager.PageSizes(true); })
                                        .Scrollable()
                            .HtmlAttributes(new { style = "height:300px;" })
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Read(read => read.Action("GetDonor", "DonorCategories"))
                             )
                        )
                    </div>
                    <!-- /widget-main -->
                </div>
                <!-- /widget-body -->
            </div>
        </div>
        <!-- /.col -->
    </div>
   
}

@section Scripts {

    <script type="text/javascript">

        function rot(ele, angle) {
            $('.refresher').fadeIn(0).delay(1000).fadeOut(300);
        }
        function clearvalidatemess() {
            $(".field-validation-error span").remove();
        }
        $(document).ready(function () {

            //setTimeout($('.my-tooltip-link').tooltip({ placement: 'top' }));
            $("#btnGridAdd,#btnToggleBox").on("click", function (e) {

                $("input[type=text]").val("");
                $("input[type=password]").val("");
                $("input[type=number]").val("");
                $("textarea").val("");
                $('#IsActive').prop('checked', true);
                $('#btnmodify').hide();
                $('#btnsubmit').show();
                clearvalidatemess();
                if ($("#btnGridAdd").hasClass("open")) {

                    if (e.target.id == "btnToggleBox") {
                        rot("#btnGridRefresh", -180);
                        $('.editBox').slideUp('slow', function () {
                            $("#btnGridAdd").removeClass("open");
                            $("#btnToggleBox").removeClass("icon-chevron-up");
                            $("#btnToggleBox").addClass("icon-chevron-down");



                        });
                    }
                }
                else {
                    if (e.target.id == "btnGridAdd") {
                        rot("#btnGridRefresh", 360);
                        $('.editBox').slideDown('slow', function () {
                            $("#btnGridAdd").addClass("open");
                            $("#btnToggleBox").removeClass("icon-chevron-down");
                            $("#btnToggleBox").addClass("icon-chevron-up");


                        });

                    }
                }

            })

            $("#btnGridRefresh").click(function () {
                // 
                rot("#btnGridRefresh", 180);
                var grid = $("#DonorGrid").data("kendoGrid");
                grid.dataSource.read();
                grid.refresh();


            });
        })

        function onChange(arg) {
            var selected = $.map(this.select(), function (item) {
                return $(item).text();
            });

            kendoConsole.log("Selected: " + selected.length + " item(s), [" + selected.join(", ") + "]");
        }

        function whileDataBound(arg) {
            $('.my-tooltip-link').tooltip({ placement: 'top' })
            addStyleSelectedGrid();
        }
        //----------------------------------------------------Create----------------------------
        $(function () {

            $('#btnsubmit').click(function () {

                debugger;

                var form1 = $("form:eq(1)");
                form1.validate();
                var result = form1.valid();
                if (!result) {
                    return false;
                }
                
                if ($('#IsActive').is(':checked')) {
                    $('#Errcheck').html(" ");
                }
                else {
                    $('#Errcheck').html("This is Requried");
                    return false;
                }
                var AccountNo = $('#AccountNo').val();
                var DonorTypes = $('#DonorTypes').val();
                var DonorCode = $('#DonorCode').val();
                var IsActive = $('#IsActive').prop('checked');

                $.ajax(
                {

                    type: "POST",
                    url: '@Url.Content("~/")' + "DonorCategories/Create",
                    dataType: "json",
                    data: "AccountNo=" + AccountNo + "&DonorTypes=" + DonorTypes + "&IsActive=" + IsActive + "&DonorCode=" + DonorCode,

                    success: function (data) {

                        debugger;

                        var d = $("#DonorGrid").data("kendoGrid");
                        d.dataSource.pageSize(10);
                        d.dataSource.data(data.lstDonorCategories);

                        var updatemsg = data.strStatusMsg;
                        
                        if (updatemsg == "Created") {
                            $("#Divmess").fadeIn('slow');
                            $("#Divmess").delay(4000).fadeOut('slow');
                            $('#divmessup').html("Saved Successfully...");
                        }
                        else {
                            $("#Divmess").fadeIn('slow');
                            $("#Divmess").delay(4000).fadeOut('slow');
                            $('#divmessup').html("<span style='color:red'>The same Donation type already exists.Save failed...<span>");
                        }

                        $('.editBox').slideUp('slow');
                        $("#btnGridAdd").removeClass("open");
                        $('#IsActive').prop('checked', false);
                        $("input[type=text]").val("");
                        $("input[type=number]").val("");
                        clearvalidatemess();
                        $("textarea").val("");
                        $('#btnmodify').hide();
                        $('#btnsubmit').show();
                    },
                    error: function (req, status, error) {
                        $("#UpdateError").modal('show');
                    }
                });
            });
        });



        // -----------------------------------------------Delete------------------------------

        $(function () {
            $('#DonorGrid').on('click', '.chkbx', function () {
                var checked = $(this).is(':checked');
                var grid = $('#DonorGrid').data().kendoGrid;
                var dataItem = grid.dataItem($(this).closest('tr'));
                dataItem.set('IsCheck', checked);
            })
        })

        function checkAll(ele) {
            var state = $(ele).is(':checked');
            var grid = $('#DonorGrid').data().kendoGrid;
            $.each(grid.dataSource.view(), function () {
                if (this['IsCheck'] != state)
                    this.dirty = true;
                this['IsCheck'] = state;
            });
            grid.refresh();
        }


        $(document).ready(function () {

            $('input.myClass').prettyCheckable();

            var selection = new Array();

            $("#btnDelete1").click(function () {

                var items = $("#DonorGrid").data("kendoGrid").dataSource.data();
                var selection = [];
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item.IsCheck) {
                        selection.push(item.Id);
                    }
                }

                if (selection.length == '0') {
                    $(".ModalHeading").html("Donor Categories");
                    $('#selectitem').modal('show')
                    return false;
                }

                $(".ModalHeading").html("Donor Categories");
                $('#myModal').modal('show');

            });

            //update to db
            $("#btnok").click(function () {

                var items = $("#DonorGrid").data("kendoGrid").dataSource.data();
                var selection = [];
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item.IsCheck) {
                        selection.push(item.Id);
                    }
                }


                $.ajax(
                                            {
                                                type: "GET",
                                                url: '@Url.Content("~/")' + "DonorCategories/Delete",
                                                data: "id=" + selection,
                                                dataType: "json",

                                                success: function (data) {
                                                    var d = $("#DonorGrid").data("kendoGrid");
                                                    d.dataSource.pageSize(10);
                                                    d.dataSource.data(data.lstDonorCategories);

                                                    var updatemsg = data.strStatusMsg;
                                                    if (updatemsg == "Deleted") {
                                                        $("#Divmess").fadeIn('slow');
                                                        $("#Divmess").delay(4000).fadeOut('slow');
                                                        $('#divmessup').html("Deleted Successfully...");
                                                        $('#masterCheckBox').prop('checked', false);
                                                        // alert($('#divmessup').val());

                                                    }
                                                    else {
                                                        var donortype = data.strDonorType;
                                                        $("#Divmess").fadeIn('slow');
                                                        $("#Divmess").delay(6000).fadeOut('slow');
                                                        $('#divmessup').html("<span style='color:red'>Fund Type " + donortype + " being used by many donation entries, please make sure that there is no donation under this donation type..<span>");
                                                    }

                                                },
                                                error: function (req, status, error) {

                                                }
                                            });//.done(function () { $('#Div1').fadeIn('slow'); $("#Div1").delay(2000).fadeOut('slow'); });


                $('#myModal').modal('hide')
            });
        });

                                    //--------------------------------------------------------Edit ----------------------------------------------------------

                                    function ProCatEdit(a) {
                                        var tempid = a;

                                        $.ajax(
                                          {
                                              type: "GET",
                                              url: '@Url.Content("~/")' + "DonorCategories/Edit",
                                              dataType: "json",
                                              data: "Id=" + tempid,

                                              success: function (data) {

                                                  var st = data[0].Statuscheck;
                                                  $('#hideid').val(data[0].Id);
                                                  $('#AccountNo').val(data[0].AccountNo);
                                                  $('#DonorTypes').val(data[0].DonorTypes);
                                                  $('#DonationCode').val(data[0].DonationCode);
                                                  $("#IsActive").prop('checked', data[0].IsActive);
                                                  $('#btnsubmit').hide();
                                                  $('#btnmodify').show();
                                              },


                                          }).done(function () {
                                              $('.editBox').slideDown('slow');
                                              $("#btnGridAdd").removeClass("open");
                                              $("#btnToggleBox").removeClass("icon-chevron-down");
                                              $("#btnToggleBox").addClass("icon-chevron-up");
                                          });
                                      };




                                      $(document).ready(function () {

                                          $('#btnmodify').click(function () {
                                              var form1 = $("form:eq(1)");
                                              form1.validate();
                                              var result = form1.valid();
                                              if (!result) {
                                                  return false;
                                              }
                                              
                                              var tempid = $('#hideid').val();
                                              var AccountNo = $('#AccountNo').val();
                                              var DonorTypes = $('#DonorTypes').val();
                                              var DonationCode = $('#DonationCode').val();
                                              var IsActive = $('#IsActive').prop('checked');
                                              

                                              $.ajax(
                                              {

                                                  type: "POST",
                                                  url: '@Url.Content("~/")' + "DonorCategories/Edit",
                                                  dataType: "json",
                                                  data: "Id=" + tempid + "&AccountNo=" + AccountNo + "&DonorTypes=" + DonorTypes + "&IsActive=" + IsActive + "&DonationCode=" + DonationCode,

                                                  success: function (data) {
                                                      var d = $("#DonorGrid").data("kendoGrid");
                                                      d.dataSource.pageSize(10);
                                                      d.dataSource.data(data.lstDonorCategories);

                                                      var updatemsg = data.strStatusMsg;
                                                      if (updatemsg == "Updated") {
                                                          $("#Divmess").fadeIn('slow');
                                                          $("#Divmess").delay(4000).fadeOut('slow');
                                                          $('#divmessup').html("Updated Successfully...");
                                                      }
                                                      else {
                                                          $("#Divmess").fadeIn('slow');
                                                          $("#Divmess").delay(3000).fadeOut('slow');
                                                          $('#divmessup').html("The Same Donation Name already exists.Updation failed...");
                                                      }
                                                      $('.editBox').slideUp('slow');
                                                      $("#btnGridAdd").removeClass("open");
                                                      $('#IsActive').prop('checked', false);
                                                      $("input[type=text]").val("");
                                                      $("input[type=number]").val("");
                                                      $("textarea").val("");
                                                      $('#btnmodify').hide();
                                                      $('#btnsubmit').show();
                                                  },
                                                  error: function (req, status, error) {
                                                      $("#UpdateError").modal('show');
                                                  }
                                              });
                                          });
                                      });

                                      $(document).ready(function () {
                                          $("#btnclear").click(function () {
                                              $("input[type=text]").val("");
                                              $("input[type=password]").val("");
                                              $("input[type=number]").val("");
                                              $('#Errcheck').html(" ");
                                              $('#IsActive').prop('checked', false);
                                              $("textarea").val("");
                                              clearvalidatemess();
                                              $('#btnsubmit').show();
                                              $('#btnmodify').hide();
                                              return false;
                                          });
                                      });

                                      $(document).ready(function () {
                                          $("input[type=text]").val("");
                                          $("input[type=number]").val("");
                                          $("textarea").val("");
                                          clearvalidatemess();
                                      });

    </script>

    @Scripts.Render("~/bundles/jqueryval")
}
