@model E_Challan.Models.ClsEChallan

@section Title {
    <title>FundCollection Monthwise</title>
}


@{
    ViewBag.Title = "FundCollection Monthwise";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section PHbreadcrumb {
    <li>
        <i class="icon-home home-icon"></i>
        @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">Reports</li>
    <li class="active">Fund Collection Monthwise</li>

}

<div class="alert alert-block alert-warning" id="Divmess" style="display: none;">
    <a href="~/Views/PrintReceipt/PrintReceipt.cshtml"></a>
    <button type="button" class="close" data-dismiss="alert">
        <i class="icon-remove"></i>
    </button>
    <i class="icon-ok green"></i>
    <span id="divmessup" style="color: #008000; font-weight: bold"></span>
</div>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)
    
    <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">Fund Collection Monthwise
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            @*<li class="refresher"><span class="icon "></span></li>
                            <li></li>
                            <li><span class=" icon-plus-sign bigger-110 purple my-tooltip-link" id='btnGridAdd' rel='tooltip' title='Add State'></span></li>
                            <li><span class="icon-trash bigger-110 red my-tooltip-link" id='btnDelete1' rel='tooltip' title='Delete State'></span></li>
                            <li><span class="icon-refresh bigger-110 green my-tooltip-link" id='btnGridRefresh' rel='tooltip' title='Refresh Data'></span></li>*@
                            <li>
                                <input type="button" id="btnSubmit" class="btn btn-success" value="Get Print" /></li>
                        </ul>
                    </span>
                        </h4>
                    </div>
                    <div class="widget-body">
                        <div class="widget-main">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <div class="col-md-4" align="right">
                                                <label>Period :</label>
                                            </div>
                                            <div class="col-md-7">
                                                @(Html.Kendo().DropDownListFor(model => model.period)
                                                .HtmlAttributes(new { style = "width:164px" })
                                                  .DataTextField("Text")
                                                  .DataValueField("Value")
                                                   // .Events(e => e.Change("change"))
                                                  .BindTo(new List<SelectListItem>() {
                                                      new SelectListItem() {
                                                          Text = "2014",
                                                          Value = "2014"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "2015",
                                                          Value = "2015"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "2016",
                                                          Value = "2016"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "2017",
                                                          Value = "2017"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "2018",
                                                          Value = "2018"
                                                      },
                                                       new SelectListItem() {
                                                          Text = "2019",
                                                          Value = "2019"
                                                      },
                                                      new SelectListItem() {
                                                          Text = "2020",
                                                          Value = "2020"
                                                      },
                                                      
                                                      new SelectListItem() {
                                                          Text = "2021",
                                                          Value = "2021"
                                                      }
                                                  }))
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <div class="col-md-4" align="right">

                                                <label>From Date :</label>
                                            </div>

                                            <div class="col-md-7">
                                                @Html.TextBoxFor(Model => Model.FromDate, new { onkeypress = "return restricttype(event)", @readonly = "readonly" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-3">

                                        <div class="form-group">
                                            <div class="col-md-4" align="right">

                                                <label>To Date :</label>
                                            </div>

                                            <div class="col-md-7">
                                                @Html.TextBoxFor(Model => Model.ToDate, new { onkeypress = "return restricttype(event)", @readonly = "readonly" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br />

                
                <!-- /widget-main -->
            </div>
            <!-- /widget-body -->
      </div>
    </div>
    
}
<script>
    function change() {
        var period = $('#period').val();
        var fdcy = "01/04/" + period;
        $("#FromDate").val(fdcy);
        var year = parseInt(period) + 1;
        var ldcy = "31/03/" + year;
        $("#ToDate").val(ldcy);

    }

    function GenerateRpt() {

        var year = $('#period').val();
        var fromdate = $('#FromDate').val();
        var todate = $('#ToDate').val();

        $.ajax({

            type: "get",
            url: "@Url.Content("~/")" + "PrintReceipt/Json_CheckMonthReport",
            datatype: "json",
            data: "fromdate=" + fromdate + "&todate=" + todate,
            success: function (data) {

                if (data == "Yes") {
                    var year = $('#period').val();
                    var fromdate = $('#FromDate').val();
                    var todate = $('#ToDate').val();
                    window.location = "@Url.Content("~/PrintReceipt/fncFundReport?intyear=")" + year + "&fromdate=" + fromdate + "&todate=" + todate;
                }
                else {
                    $("#Div2").fadeIn('slow');
                    $("#Div2").delay(4000).fadeOut('slow');
                    $('#UpdateSP').html("No Records Found...");
                }
            },
            error: function (data) {
                alert("error");
            }


        })


    }

</script>


<script>
   
    $(document).ready(function () {
         change();
         $('#period').change(function () {
            change();
         })

         $('#btnSubmit').click(function () {

             GenerateRpt();
             
         })


    })

    

    

   
   
</script>

@Scripts.Render("~/bundles/jqueryval")


