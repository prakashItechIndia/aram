        <table id="tblBelowHeader" border="1">
            @if (Model != null)
            {
                int TempHInt = 0;
                int TotalHInt = 0;
                int TempColumnTotalInt = 0;
                int TempHeaderInt = 0;
                int TempHeaderCount = 0;  
                
                <tr>
                    @foreach (var item in Model.lstHeader)
                    {
                        TempHeaderCount = TempHeaderCount + 1;

                        if (TempHeaderCount <= item.chkHeaderCount)
                        {
                            if (TempHeaderInt == 0)
                            {
                        <th style="border: 1px solid; width: 37%; text-align: center;background-color: #beebfc;" colspan="3">
                            @Html.DisplayTextFor(x => item.DonorTypes)
                        </th>
                                TempHeaderInt = 1;
                            }
                            else
                            {  
                        <th style="border: 1px solid; width: 27%; text-align: center;background-color: #beebfc;" colspan="2">
                            @Html.DisplayTextFor(x => item.DonorTypes)
                        </th>
                            }
                        }
                        else
                        {
                            break;
                        }
                    }
                </tr>
                <tr>
                    @foreach (var item in Model.lstBelowHeader)
                    {
                        // TotalHInt = TotalHInt + 1;
                        if (item.chkCount == 1)
                        {
                            if (TempHInt == 0)
                            {
                                TempHInt = 1;
                        <td style="border: 1px solid; text-align: center;">Date
                        </td>  
                            }
                               
                        <td style="border: 1px solid; text-align: center;">Receipt Number
                        </td>
                        <td style="border: 1px solid; text-align: center";>Amount
                        </td>
                            if (TotalHInt == item.DonerTypeCount - 1)
                            {
                        <td style="border: 1px solid; font-weight: bold; text-align: center;">Total
                        </td>
                            }
                            TotalHInt = TotalHInt + 1;
                        }
                    }
                </tr>
        

                    for (int i = 1; i < Model.lstBelowHeader.Count(); i++)
                    {
                        int TempInt = 0;
                        int TotalInt = 0;
                        for (int d = 0; d < Model.lstDateCount.Count(); d++)
                        {
                            if (Model.lstDateCount.Count() >= d)
                            {
                                <tr>
                    @foreach (var item in Model.lstBelowHeader)
                    {
                        if (item.chkCount == i)
                        {
                            if (TempInt == 0)
                            {
                                TempInt = 1; 
                        <td style="border: 1px solid; text-align: left;">
                            @Html.DisplayTextFor(x => item.srtRecptDate)

                        </td>
                            } 
                        <td style="border: 1px solid;">
                            @Html.DisplayTextFor(x => item.strRecptNo)

                        </td>
                        <td style="border: 1px solid; text-align: right;">
                            @Html.DisplayTextFor(x => item.decAmount)

                        </td>
                            if (TotalInt == item.DonerTypeCount - 1)
                            {
                        <td style="border: 1px solid; font-weight: bold; text-align: right;">
                            @Html.DisplayTextFor(x => item.RowTotal)

                        </td>
                            }
                            TotalInt = TotalInt + 1;
                        }
                    }
                    
                </tr> 
                    break;

                            }

                        }
                    }
                <tr>
                    @foreach (var item in Model.lstGrandTotal)
                    {
                        if (TempColumnTotalInt == 0)
                        {
                        <td></td>
                        <td></td>
                        <td style="border: 1px solid; font-weight: bold; text-align: right;">
                            @Html.DisplayTextFor(x => item.ColoumTotal)

                        </td>
                        }
                        else
                        {
                        <td></td>
                        <td style="border: 1px solid; font-weight: bold; text-align: right;">
                            @Html.DisplayTextFor(x => item.ColoumTotal)
                        </td> 
                        }
                        if (TempColumnTotalInt == item.chkGrantTotalCount - 1)
                        {
                    <td style="border: 1px solid; font-weight: bold; text-align: right;">
                        @Html.DisplayTextFor(x => item.GrandTotal)
                    </td>
                        }

                        TempColumnTotalInt = TempColumnTotalInt + 1;

                    }
                </tr>
            }

        </table>

    </div>