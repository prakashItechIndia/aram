                                                                    $("#Divmess").delay(4000).fadeOut('slow');
                                                                    $('#divmessup').html("No Receipt found..!");
                                                                    $('#masterCheckBox').prop('checked', false);
                                                                    // alert($('#divmessup').val());

                                                                }

                                                            },
                                                    error: function (req, status, error) {

                                                    }
                                                });//.done(function () { $('#Div1').fadeIn('slow'); $("#Div1").delay(2000).fadeOut('slow'); });


                    $('#myModal').modal('hide')


                });
            });

