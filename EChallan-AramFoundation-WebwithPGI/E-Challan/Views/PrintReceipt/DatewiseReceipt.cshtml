<script type="text/javascript">

    $(function () {
        $('#PrintReceiptGrid').on('click', '.chkbx', function () {
            var checked = $(this).is(':checked');
            var grid = $('#PrintReceiptGrid').data().kendoGrid;
            var dataItem = grid.dataItem($(this).closest('tr'));
            dataItem.set('IsCheck', checked);
        })

        $("#FromDate").kendoDatePicker({
            format: "dd/MM/yyyy",

        });
        $("#ToDate").kendoDatePicker({
            format: "dd/MM/yyyy",
        });
    })

    function checkAll(ele) {
        var state = $(ele).is(':checked');
        var grid = $('#PrintReceiptGrid').data().kendoGrid;
        $.each(grid.dataSource.view(), function () {
            if (this['IsCheck'] != state)
                this.dirty = true;
            this['IsCheck'] = state;
        });
        grid.refresh();
    }

    $('#btnSearch').click(function () {
        var FromDate = $('#FromDate').val();
        var ToDate = $('#ToDate').val();
        $.ajax(
                {
                    type: "POST",
                    url: '@Url.Content("~/")' + "PrintReceipt/CheckPrintReceiptDatewise",
                    dataType: "json",
                    data: "FromDate=" + FromDate + "&ToDate=" + ToDate,

                    success: function (data) {

                        var d = $("#PrintReceiptGrid").data("kendoGrid");
                        //d.dataSource.pageSize(10);
                        //d.dataSource.data(data.lstEchallan);
                        d.dataSource.read();

                        clearvalidatemess();
                    },
                    error: function (req, status, error) {
                        $("#UpdateError").modal('show');
                    }
                });
    })




            $(document).ready(function () {

