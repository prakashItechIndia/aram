@model E_Challan.Models.ClsDashboard

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<title>Dashboard</title>
@section PHbreadcrumb {
    <li>
        <i class="icon-home home-icon"></i>
        @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">Dashboard</li>
    

}
@using (Html.BeginForm()) {
    @Html.ValidationSummary(true)

   <div class="page-content">
        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">Dashboard
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>
                        </ul>
                    </span>
                        </h4>
                    </div>


                    <div class="widget-body">
                        <div class="widget-main">

                            <div class="row">
                                <div class="form-horizontal">
                                    <div class="col-md-12">
                                         <div class="alert alert-block alert-warning" id="Divmess">
                                       @* <button type="button" class="close" data-dismiss="alert">
                                            <i class="icon-remove"></i>
                                        </button>*@
                                        <i class="icon-ok green"></i>
                                        <span id="divmessup" style="color: #008000; font-weight: bold;width:100%;text-align:center">Welcome to Aram Foundation.</span>
                                    </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
       </div>
    
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
