    <script>

        function validateAlphaNumeric(e) {
            var k;
            document.all ? k = e.keyCode : k = e.which;
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || k == 32 || k == 0 || (k >= 48 && k <= 57) || k == 48);
        }

        function validateName(e) {
            var k;

            document.all ? k = e.keyCode : k = e.which;
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || k == 32 || k == 0 || k == 95 || k == 45 || k == 46);
        }

        function validateAddress(e) {
            var k;
            document.all ? k = e.keyCode : k = e.which;
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || k == 32 || k == 0 || k == 95 || k == 44 || k == 45 || k == 46 || k == 47 || k == 92 || k == 35 || k == 40 || k == 41 || (k >= 48 && k <= 57));
        }

        function validateNumeric(e) {
            var k;
            document.all ? k = e.keyCode : k = e.which;
            return ((k >= 48 && k <= 57) || k == 8 || k == 0 || k == 46);
        }

        function validatePhone(e) {
            var k;
            document.all ? k = e.keyCode : k = e.which;
            return ((k >= 48 && k <= 57) || k == 8 || k == 0 || k == 46 || k == 40 || k == 41 || k == 43 || k == 45 || k == 47 || k == 35);
        }

        function validateAlphabets(e) {
            var k;
            document.all ? k = e.keyCode : k = e.which;
            return ((k > 64 && k < 91) || (k > 96 && k < 123) || k == 8 || k == 0);
        }

        function ConfirmOnDelete(str) {
            return confirm("Are you sure to remove?...");
        }
        function textLimit(field, maxlen) {
            if (field.value.length > maxlen)
                alert("Your Text Limit is " + maxlen);
            if (field.value.length > maxlen)
                field.value = field.value.substring(0, maxlen);
        }
        function OnlyNumbers(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode
            //Alpha:63 to 90
            //Number: 48 to 57
            //Enter :13
            // Tab:9
            //Back:8
            //End:35
            //Space:32
            //Hash(#):35
            //  ( :40
            //  ) :41
            if ((charCode > 47 && charCode < 58) || (charCode == 13) || (charCode == 9) || (charCode == 8)) {
                return true;
            }
            else {
                // alert("Enter only numbers");
                return false;
            }
        }

        function OnlyNumbersSpecial(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode

            if ((charCode > 47 && charCode < 58) || (charCode == 13) || (charCode == 9) || (charCode == 8) || (charCode == 32) || (charCode == 35) || (charCode == 40) || (charCode == 41)) {
                return true;
            }
            else {

                return false;
            }
        }

        function OnlyAlphabets(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode;
            if ((charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123) || (charCode == 9) || (charCode == 8) || (charCode == 13) || (charCode == 32)) {
                return true;
            }
            else {
                return false;
            }
        }
        function OnlyNumbershyphon(evt) {
            var charCode = (evt.which) ? evt.which : event.keyCode;
            if ((charCode > 47 && charCode < 58) || (charCode == 13) || (charCode == 9) || (charCode == 8) || (charCode == 45)) {
                return true;
            }
            else {
                return false;
            }
        }
    </script>
