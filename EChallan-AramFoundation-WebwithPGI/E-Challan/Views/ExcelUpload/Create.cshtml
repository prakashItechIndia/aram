@model E_Challan.Models.ClsUploadedList

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<title>Bulk Upload</title>

@section PHbreadcrumb {
    <li>
        <i class="icon-home home-icon"></i>
        @*<a href="@Url.Action("Create","DashBoard")">Home</a>*@
    </li>
    <li class="active">Administration</li>
    <li class="active">Bulk Upload</li>

}

<div class="maskBox">
        <img src="@Url.Content("~/Images/appLoader.gif")" />
    </div>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    <div class="page-content">


        


        <!-- /.page-header -->
        <div class="row">
            <div class="col-md-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="widget-box">
                    <div class="widget-header widget-header-blue widget-header-flat">
                        <h4 class="lighter">Bulk Upload
                    <span class="gridTools">
                        <ul class="ui-pg-button ">
                            <li class="refresher"><span class="icon "></span></li>
                        </ul>
                    </span>
                        </h4>
                    </div>
                   
                    <div class="widget-body">
                        <div class="widget-main">

                            <div class="row">
                                <div class="form-horizontal">
                                    <div class="col-md-12">
                                        <div class="form-horizontal" role="form">
                                            <div class="col-md-6">

                                                <div class="form-group">
                                                    <div class="col-md-4" align="right">
                                                        <label>Import Excel<span style="color: red;">*</span> :</label>
                                                    </div>
                                                    <div class="col-md-6">
                                                        @(Html.Kendo().Upload()
                                                       .Name("files")
                                                        .Events(a => a.Select("OnSelectFoto")
                                                                 .Remove("OnRemoveFoto")
                                                        )
                                                       .Multiple(true)
                                                        .HtmlAttributes(new { id = "files" }))

                                                        <span class="k-invalid-msg" data-for="fileUpload"></span>
                                                        <span id="errBulkUpload" style="color:red"></span>
                                                        <input type="hidden" id="hdBulkUpload" />

                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <div class="col-md-4" align="right">
                                                    </div>
                                                    <div class="col-md-6">
                                                        
                                                        <input type="submit" class="btn btn-primary customeBtn" value="Upload" id="btnvalidate" />
                                                        <a href="@Url.Content("~/Images/SaiEchallanAram.xlsx")" rel="stylesheet">Sample Excel sheet</a>
                                                         @ViewData["UploadedCount"]
                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    
                </div>

            </div>
        </div>

        <br />

         <div class="alert alert-block alert-warning" id="divError" style="display:none">
                        <button type="button" class="close" data-dismiss="alert">
                            <i class="icon-remove"></i>
                        </button>
                        <i class="icon-exclamation-sign red msg"> Failed to upload.Following records contains errors in the uploaded excel.Please rectify those errors and upload again with the help of row number shown at the right.</i>
                        <span id="errspan" style="color: #008000; font-weight: bold">
                            <table id="errtable" class="table table-condensed table-bordered">
                                <th style="color:#BF5730">Donation Code</th>
                                <th style="color:#BF5730">Donar Name</th>
                                <th style="color:#BF5730">Email</th>
                                <th style="color:#BF5730">Receipt Date</th>
                                <th style="color:#BF5730">Payment Mode</th>
                                <th style="color:#BF5730">Remarks</th>
                                <th style="color:#BF5730">Row No.   </th>
                            </table>

                        </span>
          </div>
    </div>
    
}



@section Scripts {


    <script type="text/javascript">

        function OnSelectFoto(e) {

            getFileInfo(e);
        }

        function getFileInfo(e) {

            $.map(e.files, function (file) {

                if (file.extension != ".xls" && file.extension != ".xlsx") {
                    alert('only allowed .xls or .xlsx file');
                    e.preventDefault();
                    return false;
                }
                $('#hdBulkUpload').val("Yes");
                $('#errBulkUpload').html("");
            }).join(", ");
        }

        function OnRemoveFoto(e) {
            $('#hdBulkUpload').val("");

        }


    </script>


    <script type="text/javascript">


        $(document).ready(function () {

            var testmsg = '@Html.Raw(ViewBag.test)'
            
            if (testmsg != "") {
                $("#divError").show();
                $('#errtable').append(testmsg);
                $('.maskBox').height($(window).height()).fadeOut(500);
            }

            $("#btnvalidate").click(function () {

                var validationcheck = $('#hdBulkUpload').val();
               
                if (validationcheck == "Yes") {
                    if ($('.maskBox').length) {
                        $('.maskBox').height($(window).height()).fadeIn(500);
                    }
                }
                else {
                    $('#errBulkUpload').html("Please select file to be uploaded");
                    return false;
                }
            });
            


            

            var message = '@ViewData["statusMsg"]';

            var errormsg = '@ViewData["Error"]';

            
            var Unuploadedcnt = '@ViewData["UnuploadedCount"]';


            if (errormsg == "WrongFormat") {
                //alert('call');
                $("#Div2").fadeIn('slow');
                $("#Div2").delay(3000).fadeOut('slow');
                $('#UpdateSP').html("<span style='color:red'>Oops! You have uploaded wrong Excel sheet..Please upload correct Excel format sheet..</span>");
                $('.maskBox').height($(window).height()).fadeOut(500);
            }



           
            if (message == "Success") {
                $("#Div2").fadeIn('slow');
                $("#Div2").delay(3000).fadeOut('slow');
                $('#UpdateSP').html("Uploaded Successfully...");
                $('.maskBox').height($(window).height()).fadeOut(500);
            }

            if (Uploadedcnt !=0) {
                $("#Div2").fadeIn('slow');
                
                $('#UpdateSP').html("Uploaded Files-" + Uploadedcnt + "...Unuploaded Files-" + Unuploadedcnt);
            }


        })

      

    </script>

  



    @Scripts.Render("~/bundles/jqueryval")
}
